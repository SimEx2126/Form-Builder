# ---------------------------------------------------------------------------
# Storage mode
#   STORAGE=local  -> files saved to ./uploads on disk (no AWS needed; great
#                     for local dev and demos). This is the default.
#   STORAGE=s3     -> files go straight to an S3 bucket via presigned URLs.
# ---------------------------------------------------------------------------
STORAGE=local

# Server
PORT=4000
# Public base URL the browser uses to reach THIS server (used to build
# local upload/download URLs in local mode). Change if not on localhost.
PUBLIC_BASE=http://localhost:4000

# Upload rules
# Max file size in bytes. Default 2 GiB. (S3 single-PUT max is 5 GiB.)
MAX_UPLOAD_BYTES=2147483648

# ---------------------------------------------------------------------------
# AWS / S3 settings (only needed when STORAGE=s3)
# ---------------------------------------------------------------------------
AWS_REGION=ap-southeast-2
S3_BUCKET=your-private-bucket-name
# Credentials: prefer an IAM role in production. For local testing you can use:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
