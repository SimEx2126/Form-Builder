{
  "name": "file-submission-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend for the file-submission feature: issues S3 presigned upload URLs and stores submission metadata.",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test test/api.test.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "loadtest": "node scripts/loadtest.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0",
    "nanoid": "^5.0.7"
  }
}
